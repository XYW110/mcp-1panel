# 1Panel MCP server 环境变量
# 复制为 .env 并填入真实值后运行 docker compose up -d

# ===== 1Panel 面板连接 =====
# 面板地址，如 http://192.168.1.2:39579 或 https://panel.example.com
# 注意：API 请求路径是 /api/v2/...，不需要带 1Panel 的安全入口前缀（如 /ipanel）
PANEL_ENDPOINT=http://192.168.50.253:39579
# 面板「设置 → API 接口」里创建的 API Key
PANEL_API_KEY=change-me
# 请求超时秒数
PANEL_TIMEOUT=30
# 只读模式：true 时所有写操作被拒绝（安全开关）
PANEL_READONLY=false

# ===== mcphub =====
# mcphub dashboard 管理密码
MCPHUB_ADMIN_PASSWORD=change-me

# ===== PostgreSQL（mcphub smart routing 依赖）=====
DB_PASSWORD=change-me

# ===== 日志级别 =====
LOG_LEVEL=INFO
